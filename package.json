{
	"name": "line-marks",
	"version": "0.2.0-beta.3",
	"description": "An Obsidian plugin to mark lines you want to come back to, and jump between them across notes. Marks follow their lines as you edit.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . && cspell --no-progress \"**\"",
		"test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/**/*.test.ts\""
	},
	"keywords": [],
	"author": "namikaze-40p",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@types/node": "^20.19.43",
		"cspell": "^8.4.1",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.12.0",
		"obsidian": "^1.13.1",
		"tslib": "2.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1"
	}
}
